<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Quiz Teste</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,450;9..144,600&family=Work+Sans:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root{
    --cream:#FBF6EF;
    --plum:#3D2A3D;
    --plum-soft:#5B3F58;
    --berry:#C24D6E;
    --sage:#7C8C56;
    --line:rgba(61,42,61,0.14);
  }
  *{box-sizing:border-box;}
  html,body{height:100%;}
  body{
    margin:0;
    background:var(--cream);
    color:var(--plum);
    font-family:'Work Sans', sans-serif;
    display:flex;
    flex-direction:column;
    min-height:100vh;
  }
  h1,h2{ font-family:'Fraunces', serif; font-weight:450; margin:0; }
  .top{ display:flex; justify-content:center; padding:28px 24px 0; }
  .eyebrow{
    font-family:'Space Mono', monospace;
    font-size:0.72rem; letter-spacing:0.14em; text-transform:uppercase;
    color:var(--berry); display:flex; align-items:center; gap:0.6em;
  }
  .eyebrow::before, .eyebrow::after{ content:""; width:16px; height:1px; background:var(--berry); }
  main{ flex:1; display:flex; align-items:center; justify-content:center; padding:24px; }
  .shell{
    width:100%; max-width:560px; background:#fff;
    border:1px solid var(--line); border-radius:2px; padding:44px 40px;
  }
  .quiz-head{ display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:30px; gap:20px; }
  .progress-ring{ width:60px; height:60px; flex-shrink:0; }
  .progress-ring circle.track{ fill:none; stroke:var(--line); stroke-width:3; }
  .progress-ring circle.fill{
    fill:none; stroke:var(--berry); stroke-width:3; stroke-linecap:round;
    transform:rotate(-90deg); transform-origin:50% 50%; transition:stroke-dashoffset 0.5s ease;
  }
  .progress-num{ font-family:'Space Mono', monospace; font-size:0.66rem; fill:var(--plum); }
  .step-label{
    font-family:'Space Mono', monospace; font-size:0.72rem; letter-spacing:0.1em;
    text-transform:uppercase; color:var(--plum-soft); margin-bottom:6px;
  }
  .quiz-question{ font-size:1.4rem; max-width:26ch; }
  .choices{ display:grid; gap:12px; margin-top:30px; }
  .choice{
    text-align:left; background:transparent; border:1px solid var(--line); border-radius:2px;
    padding:16px 20px; font-family:'Work Sans', sans-serif; font-size:1rem; cursor:pointer;
    display:flex; align-items:center; gap:14px; transition:border-color .15s, background .15s;
  }
  .choice:hover{ border-color:var(--berry); background:rgba(194,77,110,0.05); }
  .choice .dot{ width:9px; height:9px; border-radius:50%; border:1.4px solid var(--plum-soft); flex-shrink:0; }
  .quiz-nav{ display:flex; justify-content:space-between; margin-top:34px; }
  .back{
    background:none; border:none; font-family:'Space Mono', monospace; font-size:0.78rem;
    letter-spacing:0.04em; text-transform:uppercase; color:var(--plum-soft); cursor:pointer;
  }
  .back:disabled{ opacity:0.35; cursor:not-allowed; }
  #result-view{ display:none; }
  .result-tag{
    font-family:'Space Mono', monospace; font-size:0.72rem; text-transform:uppercase;
    letter-spacing:0.1em; color:var(--sage);
  }
  .result-title{ font-size:1.7rem; margin:12px 0 16px; }
  .result-body{ color:var(--plum-soft); margin-bottom:26px; }
  .btn-ghost{
    background:transparent; color:var(--plum); border:1px solid var(--line);
    font-family:'Space Mono', monospace; font-size:0.82rem; letter-spacing:0.04em;
    text-transform:uppercase; padding:14px 22px; border-radius:2px; cursor:pointer;
  }
  .btn-ghost:hover{ background:rgba(61,42,61,0.05); }
  footer{ padding:20px 24px 28px; text-align:center; }
  .footer-note{ font-family:'Space Mono', monospace; font-size:0.65rem; color:var(--plum-soft); }
  @media (max-width:600px){ .shell{ padding:30px 22px; } .quiz-head{ flex-direction:column; align-items:flex-start; } }
</style>
</head>
<body>

<div class="top"><div class="eyebrow">Quiz Teste</div></div>

<main>
  <div id="quiz-view" class="shell">
    <div class="quiz-head">
      <div>
        <div class="step-label" id="step-label">Pergunta 1 de 4</div>
        <h2 class="quiz-question" id="q-text"></h2>
      </div>
      <svg class="progress-ring" viewBox="0 0 66 66">
        <circle class="track" cx="33" cy="33" r="28"/>
        <circle class="fill" id="ring-fill" cx="33" cy="33" r="28" stroke-dasharray="176" stroke-dashoffset="176"/>
        <text x="33" y="38" text-anchor="middle" class="progress-num" id="ring-num">1/4</text>
      </svg>
    </div>
    <div class="choices" id="choices"></div>
    <div class="quiz-nav">
      <button class="back" id="back-btn" onclick="goBack()">← Voltar</button>
      <span></span>
    </div>
  </div>

  <div id="result-view" class="shell">
    <div class="result-tag">Resultado</div>
    <h2 class="result-title" id="result-title"></h2>
    <p class="result-body" id="result-body"></p>
    <button class="btn-ghost" onclick="restartQuiz()">Refazer o quiz</button>
  </div>
</main>

<footer><div class="footer-note">Página de teste — /quizz1</div></footer>

<script>
  const questions = [
    { key:"q1", text:"Qual desses combina mais com sua rotina?", options:["Corrida cedo","Café calmo","Academia à noite","Yoga no fim do dia"] },
    { key:"q2", text:"O que te motiva mais?", options:["Resultados rápidos","Constância","Ciência por trás","Bem-estar geral"] },
    { key:"q3", text:"Como você prefere aprender algo novo?", options:["Vídeos curtos","Guias passo a passo","Testando na prática","Conversando com alguém"] },
    { key:"q4", text:"Qual seu maior desafio hoje?", options:["Falta de tempo","Falta de informação","Falta de motivação","Não sei por onde começar"] }
  ];

  const results = {
    "Falta de tempo": { title:"Você precisa de algo direto ao ponto.", body:"Rotinas curtas e objetivas tendem a funcionar melhor pra você." },
    "Falta de informação": { title:"Você aprende melhor com um passo a passo claro.", body:"Um guia bem estruturado facilita muito o seu processo." },
    "Falta de motivação": { title:"Pequenas vitórias fazem toda diferença pra você.", body:"Metas menores e visíveis ajudam a manter o ritmo." },
    "Não sei por onde começar": { title:"Você só precisa de um primeiro passo simples.", body:"Comece pequeno — o resto vem com consistência." }
  };

  let current = 0;
  const answers = {};

  function renderQuestion(){
    const q = questions[current];
    document.getElementById('step-label').textContent = `Pergunta ${current+1} de ${questions.length}`;
    document.getElementById('q-text').textContent = q.text;
    document.getElementById('ring-num').textContent = `${current+1}/${questions.length}`;
    document.getElementById('back-btn').disabled = current === 0;

    const ring = document.getElementById('ring-fill');
    const circumference = 176;
    ring.style.strokeDashoffset = circumference - (circumference * (current / questions.length));

    const box = document.getElementById('choices');
    box.innerHTML = "";
    q.options.forEach(opt => {
      const b = document.createElement('button');
      b.className = 'choice';
      b.innerHTML = `<span class="dot"></span>${opt}`;
      b.onclick = () => selectAnswer(q.key, opt);
      box.appendChild(b);
    });
  }

  function selectAnswer(key, value){
    answers[key] = value;
    if(current < questions.length - 1){
      current++;
      renderQuestion();
    } else {
      showResult();
    }
  }

  function goBack(){
    if(current > 0){ current--; renderQuestion(); }
  }

  function showResult(){
    document.getElementById('ring-fill').style.strokeDashoffset = 0;
    const r = results[answers.q4] || results["Não sei por onde começar"];
    document.getElementById('result-title').textContent = r.title;
    document.getElementById('result-body').textContent = r.body;
    document.getElementById('quiz-view').style.display = 'none';
    document.getElementById('result-view').style.display = 'block';
  }

  function restartQuiz(){
    current = 0;
    for(const k in answers) delete answers[k];
    document.getElementById('result-view').style.display = 'none';
    document.getElementById('quiz-view').style.display = 'block';
    renderQuestion();
  }

  renderQuestion();
</script>

</body>
</html>
